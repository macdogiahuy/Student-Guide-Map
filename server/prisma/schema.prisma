// Student Guide Map — Prisma schema (PostgreSQL)
// ERD notes & index rationale: docs/ERD.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  STUDENT
  STORE_OWNER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum LocationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LocationActiveStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum ReviewStatus {
  DISPLAYED
  HIDDEN
  DELETED
}

enum PromotionStatus {
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
}

enum ReportType {
  WRONG_ADDRESS
  WRONG_PRICE
  WRONG_HOURS
  CLOSED
  OTHER
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum CorrectionStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum NotificationType {
  ACCOUNT_VERIFIED
  PASSWORD_RESET
  LOCATION_APPROVED
  LOCATION_REJECTED
  PROMOTION_APPROVED
  PROMOTION_REJECTED
  REPORT_UPDATE
  REVIEW_REPLY
  LOCATION_INFO_UPDATE
}

// ─────────────────────────── Auth / Users ───────────────────────────

model User {
  id              String       @id @default(cuid())
  fullName        String
  email           String       @unique
  passwordHash    String
  phone           String?
  role            Role         @default(STUDENT)
  status          UserStatus   @default(PENDING_VERIFICATION)
  avatarUrl       String?
  storeName       String? // for STORE_OWNER (store profile)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  locations         Location[]        @relation("LocationOwner")
  reviews           Review[]
  favorites         Favorite[]
  reports           Report[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  reviewReplies     ReviewReply[]
  processedReports  Report[]          @relation("ReportProcessor")
  correctionRequests CorrectionRequest[]

  @@index([role, status])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpToken {
  id         String     @id @default(cuid())
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

// ─────────────────────────── Categories & Locations ───────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String   @default("pin") // icon name resolved by frontend
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations Location[]

  @@index([isActive, sortOrder])
}

model Location {
  id            String               @id @default(cuid())
  name          String
  description   String?
  address       String
  lat           Float
  lng           Float
  phone         String?
  categoryId    String
  ownerId       String
  priceLevel    Int                  @default(1) // 1..3 → ₫, ₫₫, ₫₫₫
  priceRange    String? // e.g. "15.000 – 45.000₫"
  status        LocationStatus       @default(PENDING)
  activeStatus  LocationActiveStatus @default(ACTIVE)
  rejectionReason String?
  ratingAvg     Float                @default(0)
  ratingCount   Int                  @default(0)
  viewCount     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  approvedAt    DateTime?

  category         Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  owner            User               @relation("LocationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  images           LocationImage[]
  openingHours     OpeningHour[]
  reviews          Review[]
  favorites        Favorite[]
  promotions       Promotion[]
  reports          Report[]
  priceReferences  PriceReference[]
  correctionRequests CorrectionRequest[]

  // search / filter / approval queue paths
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([ownerId, status])
  @@index([ratingAvg])
  @@index([lat, lng])
  @@index([name])
}

model LocationImage {
  id        String   @id @default(cuid())
  locationId String
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, sortOrder])
}

model OpeningHour {
  id         String    @id @default(cuid())
  locationId String
  day        DayOfWeek
  openTime   String    @default("08:00") // "HH:mm"
  closeTime  String    @default("22:00")
  isClosed   Boolean   @default(false)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, day])
}

model PriceReference {
  id         String   @id @default(cuid())
  locationId String
  itemName   String // e.g. "Cà phê sữa đá"
  price      Int // VND
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

// ─────────────────────────── Reviews ───────────────────────────

model Review {
  id         String       @id @default(cuid())
  locationId String
  userId     String
  rating     Int // 1..5
  comment    String?
  status     ReviewStatus @default(DISPLAYED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  location Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply    ReviewReply?

  @@unique([userId, locationId]) // one review per user per location (edit instead of duplicate)
  @@index([locationId, status])
  @@index([userId, createdAt])
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  ownerId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// ─────────────────────────── Favorites / Promotions / Reports ───────────────────────────

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId]) // duplicate prevention at DB level
  @@index([userId, createdAt])
}

model Promotion {
  id             String          @id @default(cuid())
  locationId     String
  title          String
  content        String
  discountLabel  String? // e.g. "Giảm 20%", "Combo 2 tặng 1"
  startDate      DateTime
  endDate        DateTime
  conditions     String?
  status         PromotionStatus @default(PENDING)
  rejectionReason String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  approvedAt     DateTime?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([status, endDate])
  @@index([locationId, status])
  @@index([startDate, endDate])
}

model Report {
  id           String       @id @default(cuid())
  locationId   String
  reporterId   String
  type         ReportType
  content      String?
  status       ReportStatus @default(PENDING)
  adminNote    String?
  processedById String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  processedBy User?    @relation("ReportProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([locationId])
}

model CorrectionRequest {
  id           String           @id @default(cuid())
  locationId   String
  requesterId  String
  field        String? // which info is wrong: address / hours / phone ...
  description  String
  status       CorrectionStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  requester User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([locationId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
