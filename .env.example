# ── Database ──
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/student_guide_map"
DATABASE_URL_TEST="postgresql://postgres@127.0.0.1:5432/student_guide_map_test"

# ── Server ──
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ── Auth ──
JWT_SECRET="generate-with-openssl-rand-hex-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-32"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Uploads ──
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE="5242880"

# ── Optional SMTP (OTP emails; when empty, codes are logged to server console) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Student Guide Map <no-reply@studentguidemap.local>"

# ── Map defaults (FPT University Đà Nẵng — Khu K, Ngũ Hành Sơn) ──
DEFAULT_CENTER_LAT=15.9675
DEFAULT_CENTER_LNG=108.2604

# ── Frontend (web/.env) ──
# VITE_API_URL="http://localhost:4000/api/v1"
