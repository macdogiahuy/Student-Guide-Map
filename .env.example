# ── Database ──
# Local dev: direct Postgres, DIRECT_URL can equal DATABASE_URL.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/student_guide_map"
DIRECT_URL="postgresql://postgres@127.0.0.1:5432/student_guide_map"
# Prod (Supabase): DATABASE_URL = Transaction Pooler (port 6543) + ?pgbouncer=true,
# DIRECT_URL = Direct connection (port 5432, used by `prisma migrate deploy`).
# Test database (used by npm test)
DATABASE_URL_TEST="postgresql://postgres@127.0.0.1:5432/student_guide_map_test"

# ── Server ──
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ── Auth ──
JWT_SECRET="generate-with-openssl-rand-hex-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-32"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Uploads ──
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE="5242880"
# Prod seed only: base URL of object storage (Vercel Blob) where seed images were
# uploaded. When set, seed stores absolute image URLs; when empty, local /uploads/…
# SEED_IMAGE_BASE_URL="https://xxx.public.blob.vercel-storage.com/seed"

# ── Optional SMTP (OTP emails; when empty, codes are logged to server console) ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Student Guide Map <no-reply@studentguidemap.local>"

# ── Map defaults (FPT University Đà Nẵng — Khu K, Ngũ Hành Sơn) ──
DEFAULT_CENTER_LAT=15.9675
DEFAULT_CENTER_LNG=108.2604

# ── Frontend (web/.env) ──
# VITE_API_URL="http://localhost:4000/api/v1"
