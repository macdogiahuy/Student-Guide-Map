{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/"
    },
    "server": {
      "root": "server/"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "server" } },
    { "source": "/vietmap/:path*", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
